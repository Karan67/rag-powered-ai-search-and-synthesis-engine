# Backend Configuration
GROQ_API_KEY=gsk_your_actual_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_db
CHUNK_SIZE=500
CHUNK_OVERLAP=100
SIMILARITY_THRESHOLD=0.3
TOP_K=5

# Ingestion. EMBEDDING_THREADS caps the ONNX thread pool: raise it on a machine
# with spare cores (8 measured ~2.5x faster than 4 on a 12-core host), lower it
# on CPU-starved hosts such as Render free tier. Batches above 64 were slower
# under a constrained container memory limit.
EMBEDDING_THREADS=8
EMBED_BATCH_SIZE=64
MAX_UPLOAD_MB=15

# Reply budgets. Groq counts prompt + max_completion_tokens against the
# per-minute cap in full, so the widened retrieval tiers need a smaller reply
# budget or the request is rejected outright with a 413.
MAX_ANSWER_TOKENS=4096
BROAD_ANSWER_TOKENS=1200
ENTITY_ANSWER_TOKENS=1536

# Comma/JSON list of origins allowed to call the API. Must match the deployed
# frontend URL exactly, or the browser blocks every request.
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
