# Backend Configuration
GROQ_API_KEY=gsk_your_actual_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_db
CHUNK_SIZE=500
CHUNK_OVERLAP=100
SIMILARITY_THRESHOLD=0.3
TOP_K=5

# Where embedding runs. "local" loads the ONNX model in-process and needs no
# credentials, but embedding one 4MB PDF is ~34 TFLOP, which a 0.1 vCPU host
# (Render free) cannot do in reasonable time. "http" calls the SAME model on a
# hosted endpoint: measured 91 chunks/s versus 7.7 locally, using ~no CPU.
# The vector space is identical (verified: worst cosine 0.999998 against vectors
# already stored in pgvector), so switching backends needs NO re-indexing.
# Cost: query embedding goes from ~50ms to ~290ms, since it becomes a network
# round trip. Use "local" for development, "http" wherever CPU is scarce.
EMBEDDING_BACKEND=local
EMBED_API_TOKEN=hf_your_huggingface_read_token_here
# Blank derives the HuggingFace inference URL from EMBEDDING_MODEL.
EMBED_API_URL=
EMBED_HTTP_BATCH=128

# Ingestion. EMBEDDING_THREADS caps the ONNX thread pool: raise it on a machine
# with spare cores (8 measured ~2.5x faster than 4 on a 12-core host), lower it
# on CPU-starved hosts such as Render free tier. Batches above 64 were slower
# under a constrained container memory limit.
EMBEDDING_THREADS=8
EMBED_BATCH_SIZE=64
MAX_UPLOAD_MB=15

# Reply budgets. Groq counts prompt + max_completion_tokens against the
# per-minute cap in full, so the widened retrieval tiers need a smaller reply
# budget or the request is rejected outright with a 413.
MAX_ANSWER_TOKENS=4096
BROAD_ANSWER_TOKENS=1200
ENTITY_ANSWER_TOKENS=1536

# Comma/JSON list of origins allowed to call the API. Must match the deployed
# frontend URL exactly, or the browser blocks every request.
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
